# 11. Velocity calculation (Convex Hull Method)
coords <- as.data.frame(xyFromCell(pc_list[[1]]$p, xy_clean$cid))
tdiff  <- 45  # years between midpoints of present (1985) and future (2090)

pca_pres <- data.table(
  cid = xy_clean$cid, x = coords$x, y = coords$y,
  PC1 = xy_clean$PC1p, PC2 = xy_clean$PC2p,
  PC3 = xy_clean$PC3p, PC4 = xy_clean$PC4p
)
pca_fut <- data.table(
  cid = xy_clean$cid, x = coords$x, y = coords$y,
  PC1 = xy_clean$PC1f, PC2 = xy_clean$PC2f,
  PC3 = xy_clean$PC3f, PC4 = xy_clean$PC4f
)

# Convex hull on first 2 PCs (hull is 2-D by definition)
hull_mat   <- as.matrix(pca_pres[, .(PC1, PC2)])
hull_idx   <- chull(hull_mat)
hull_geom  <- hull_mat[hull_idx, ]

vel_results <- data.table(
  focal_cid  = pca_fut$cid,
  target_cid = as.integer(NA),
  geoDis     = as.double(NA),
  vel        = as.double(NA),
  status     = "No-Analog"
)

is_inside <- sp::point.in.polygon(pca_fut$PC1, pca_fut$PC2,
                                  hull_geom[, 1], hull_geom[, 2]) > 0

# Pre-compute 4-D PCA distances and find analogs
pca_pres_mat <- as.matrix(pca_pres[, .(PC1, PC2, PC3, PC4)])

message("Running velocity loop for ", sum(is_inside), " analog cells ...")
for (i in which(is_inside)) {
  f_vec    <- as.numeric(pca_fut[i, .(PC1, PC2, PC3, PC4)])
  pca_dist <- sqrt(rowSums(sweep(pca_pres_mat, 2, f_vec)^2))
  
  threshold  <- quantile(pca_dist, 0.05)
  cand_idx   <- which(pca_dist <= threshold)
  candidates <- pca_pres[cand_idx]
  
  if (nrow(candidates) > 0) {
    geo_d    <- distHaversine(
      cbind(pca_fut$x[i],  pca_fut$y[i]),
      cbind(candidates$x, candidates$y)
    ) / 1000  # km
    
    best     <- which.min(geo_d)
    vel_results[i, `:=`(
      target_cid = candidates$cid[best],
      geoDis     = geo_d[best],
      vel        = geo_d[best] / tdiff,
      status     = "Analog Found"
    )]
  }
}
message("Velocity loop complete.")

