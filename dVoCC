# 10. Climate categories (Binning) 
bin_size <- 0.5                         # adjust bin size accordingly 

make_bins <- function(ax) {
  pv <- xy_clean[[paste0("PC", ax, "p")]]
  fv <- xy_clean[[paste0("PC", ax, "f")]]
  r  <- range(c(pv, fv))
  seq(floor(r[1]), ceiling(r[2]), by = bin_size)
}

bin_id <- function(ax, period) {
  col   <- paste0("PC", ax, if (period == "p") "p" else "f")
  bins  <- make_bins(ax)
  findInterval(xy_clean[[col]], bins)
}

