# 3.climPCA function
climPCA <- function(climp, climf, trans = NA, cen = TRUE, sc = TRUE, n_axes = 4) {
  p_val <- as.matrix(climp)
  f_val <- as.matrix(climf)
  
  cid_vec    <- rep(1:ncell(climp), times = 2)
  period_vec <- rep(c("present", "future"), each = ncell(climp))
  
  clim <- data.table(rbind(p_val, f_val))
  clim[, `:=`(cid = cid_vec, p = period_vec)]
  clim_clean <- na.omit(clim)
  
  pca_input <- clim_clean[, !c("cid", "p"), with = FALSE]
  if (!is.logical(trans)) pca_input <- trans(pca_input)
  
  pca_res <- prcomp(pca_input, center = cen, scale. = sc)
  
  # Cap at available PCs
  n_pcs <- min(n_axes, ncol(pca_res$x))
  
  scores <- data.frame(
    pca_res$x[, 1:n_pcs],
    cid = clim_clean$cid,
    p   = clim_clean$p
  )
  
  v_wide <- reshape(scores, idvar = "cid", timevar = "p", direction = "wide")
  
  return(list(pca_obj = pca_res, data = v_wide, n_pcs = n_pcs))
}

