# 9. load 4 PC axes and prepare datatable
get_pc <- function(period, ax) {
  key <- paste0("PC", ax, ".", period)
  if (!is.null(pc_rasters[[key]])) return(pc_rasters[[key]])
  # fallback: search on disk
  pat <- paste0("PC", ax, ".*", period, ".*", scenario_tag, "\\.tif$")
  f   <- list.files(output_path, pattern = pat, full.names = TRUE)
  if (length(f) == 0) stop("Cannot find raster for PC", ax, " ", period)
  rast(f[1])
}

pc_list <- lapply(1:n_pcs, function(ax) {
  list(p = get_pc("present", ax), f = get_pc("future", ax))
})

