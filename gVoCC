# plots with direction vectors

# Load/ install packages
required_pkgs <- c("ggplot2", "tidyterra", "metR", "colorspace", "sf")
new_pkgs <- required_pkgs[!(required_pkgs %in% installed.packages()[, "Package"])]
if (length(new_pkgs) > 0) install.packages(new_pkgs)

library(ggplot2)
library(tidyterra)  # Perfect for seamlessly plotting 'terra' or 'raster' objects in ggplot
library(metR)       # Provides geom_vector for cleaner arrow controls
library(colorspace) # Professional palette control
library(sf)
library(raster)

# 1. Prepare data
message("Preparing layers for visualization...")

# Convert your raster stack 'v' (from the previous script) into a SpatRaster or df
# If reading directly from saved outputs:
# v <- stack(file.path(out_dir, "precip_gVoCC.tif"))
vel_mag <- v[[1]] # Magnitude (km/yr)
vel_ang <- v[[2]] # Angle (0-360 degrees)

# To plot vectors, we need U (East-West) and V (North-South) components.
# Convert the angles (bearings) to radians and break into components.
# Note: R trig functions use standard Cartesian angles; adjust for geographic bearing if needed.
rad <- vel_ang * (pi / 180)
U_comp <- vel_mag * sin(rad)
V_comp <- vel_mag * cos(rad)

# Combine into a temporary brick for easy extraction
field_stack <- stack(vel_mag, U_comp, V_comp)
names(field_stack) <- c("Magnitude", "U", "V")

# 2. Downsample arrows to prevent clutters
# Plotting arrows on every cell creates an unreadable block of ink. 
# We aggregate the vector field to a coarser resolution just for the arrows.
arrow_aggregation_factor <- 5 # Aggregate every X cells. Increase if arrows are too dense.

field_coarse <- aggregate(field_stack, fact = arrow_aggregation_factor, fun = mean, na.rm = TRUE)
arrow_df     <- as.data.frame(field_coarse, xy = TRUE, na.rm = TRUE)

# Convert high-res magnitude to a dataframe for the background fill
vel_df       <- as.data.frame(vel_mag, xy = TRUE, na.rm = TRUE)
names(vel_df)[3] <- "Magnitude"

# 3. Generate maps
message("Generating publication-quality figure...")

p <- ggplot() +
  # 1. Background Fill: High-resolution Velocity Magnitude
  geom_raster(data = vel_df, aes(x = x, y = y, fill = Magnitude)) +
  
  # 2. Vector Layer: Downsampled Directional Arrows
  geom_vector(data = arrow_df, aes(x = x, y = y, dx = U, dy = V),
              arrow.size = 0.3,       # Size of arrow head
              arrow.type = "closed",   # Crisp, filled arrow heads
              color = "grey15",        # Clean, dark grey contrast over background
              pivot = 0.5,             # Rotate arrow around cell center
              skip = 0) +              # Skip can step through cells if needed, handling via aggregation is cleaner
  
  # 3. Scientific Color Palette (Perceptually uniform, colorblind-friendly)
  scale_fill_viridis_c(
    option = "plasma", 
    name = "Velocity\n(km / year)",
    na.value = "transparent",
    direction = 1
  ) +
  
  # 4. Cartographic Cosmetics
  labs(
    title = "Precipitation Climate Velocity (gVoCC)",
    subtitle = "Arrows indicate the direction of shifting climate analogs; magnitude signifies rate of displacement.",
    x = "Longitude",
    y = "Latitude"
  ) +
  
  # 5. Coordinate adjustments (ensure strict geographic aspect ratios)
  coord_equal() + 
  
  # 6. Strict Academic Journal Styling
  theme_minimal(base_size = 13, base_family = "sans") +
  theme(
    plot.title        = element_text(face = "bold", size = 15, margin = margin(b = 5)),
    plot.subtitle     = element_text(size = 10, color = "grey30", margin = margin(b = 15)),
    panel.grid.major  = element_line(color = "grey90", linewidth = 0.4),
    panel.grid.minor  = element_blank(),
    axis.title        = element_text(face = "plain", size = 11),
    axis.text         = element_text(color = "grey20", size = 9),
    legend.position   = "right",
    legend.title      = element_text(face = "bold", size = 10),
    legend.text       = element_text(size = 9),
    legend.key.height = unit(1.2, "cm"),
    legend.key.width  = unit(0.4, "cm"),
    plot.background   = element_rect(fill = "white", color = NA),
    panel.background  = element_rect(fill = "grey98", color = NA)
  )

# 4. Save plot 
output_file <- file.path(out_dir, "climate_velocity.png")

# Saving at 300 DPI ensures crisp lines for paper submittals
ggsave(
  filename = output_file,
  plot = p,
  width = 10,       # Width in inches
  height = 7,       # Height in inches
  dpi = 300,        # Publication standard resolution
  bg = "white"
)


