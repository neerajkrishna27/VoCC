
# Local (Gradient-based) climate velocity for precipitation

#  install/load packages
required_pkgs <- c("raster", "data.table", "CircStats", "geosphere", "sp", "sf")
new_pkgs <- required_pkgs[!(required_pkgs %in% installed.packages()[, "Package"])]
if (length(new_pkgs) > 0) install.packages(new_pkgs)

library(raster)
library(data.table)
library(CircStats)
library(geosphere)
library(sp)
library(sf)

# 1. Paths
climate_dir  <- "path to climate rasters."   
forest_path  <- "path to forest cover."      
out_dir      <- "set output directory."              
dir.create(out_dir, showWarnings = FALSE, recursive = TRUE)

trend_threshold <- 10   # Min years required out of 74
grad_threshold  <- 0.0001
is_projected    <- FALSE # FALSE = geographic (lon/lat, degrees); TRUE = projected

# 2. Load and stack climate files
message("Loading precipitation rasters")
clim_files <- sort(list.files(climate_dir, pattern = "\\.tif$", full.names = TRUE))
if (length(clim_files) == 0) stop("No .tif files found in climate_dir.")

clim_stack <- stack(clim_files)
message(sprintf("  Stack dimensions: %d rows x %d cols x %d layers",
                nrow(clim_stack), ncol(clim_stack), nlayers(clim_stack)))

# 3. Load Forest Mask
message("Loading forest mask")
forest <- raster(forest_path)

# 4. Align CRS
clim_crs   <- crs(clim_stack)
forest_crs <- crs(forest)

if (!compareCRS(clim_crs, forest_crs)) {
  message("CRS mismatch detected. Reprojecting forest mask")
  forest <- projectRaster(forest, crs = clim_crs, method = "bilinear")
}

# 5. Resample forest cover into that of climate rasters
message("Resampling forest mask ...")
forest_resampled <- resample(forest, clim_stack[[1]], method = "bilinear")
forest_mask <- forest_resampled
forest_mask[forest_mask[] == 0] <- NA   

# 6. Crop and Mask climate files
message("Cropping and masking climate stack to forest extent")
clim_cropped <- crop(clim_stack, extent(forest_mask))
clim_masked  <- mask(clim_cropped, forest_mask)
yrClim       <- clim_masked
clim_mean    <- calc(yrClim, mean, na.rm = TRUE)

# VoCC functions

# tempTrend
tempTrend <- function(r, th) {
  y <- getValues(r)
  ocean <- which(rowSums(is.na(y)) != ncol(y))
  y <- t(y[ocean, ])
  N <- apply(y, 2, function(x) sum(!is.na(x)))
  ind <- which(N >= th)
  y <- y[, ind]
  N <- apply(y, 2, function(x) sum(!is.na(x)))
  x <- matrix(nrow = nlayers(r), ncol = ncol(y))
  x[] <- 1:nlayers(r)
  x1 <- y
  x1[!is.na(x1)] <- 1
  x <- x * x1
  sx  <- apply(x, 2, sum, na.rm = TRUE)
  sy  <- apply(y, 2, sum, na.rm = TRUE)
  sxx <- apply(x, 2, function(x) sum(x^2, na.rm = TRUE))
  syy <- apply(y, 2, function(x) sum(x^2, na.rm = TRUE))
  sxy <- apply(x * y, 2, sum, na.rm = TRUE)
  slope <- (N * sxy - (sx * sy)) / (N * sxx - sx^2)
  sres  <- (N * syy - sy^2 - slope^2 * (N * sxx - sx^2)) / (N * (N - 2))
  SE    <- suppressWarnings(sqrt((N * sres) / (N * sxx - sx^2)))
  Test  <- slope / SE
  p     <- mapply(function(x, y) (2 * pt(abs(x), df = y - 2, lower.tail = FALSE)),
                  x = Test, y = N)
  slpTrends <- sigTrends <- seTrends <- raster(r[[1]])
  slpTrends[ocean[ind]] <- slope
  seTrends[ocean[ind]]  <- SE
  sigTrends[ocean[ind]] <- p
  output <- stack(slpTrends, seTrends, sigTrends)
  names(output) <- c("slpTrends", "seTrends", "sigTrends")
  return(output)
}

#  angulo 
angulo <- function(dx, dy) {
  d <- cbind(dx, dy)
  angline <- function(rw) {
    angle <- ifelse(rw[2] < 0, 180 + CircStats::deg(atan(rw[1] / rw[2])),
                    ifelse(rw[1] < 0, 360 + CircStats::deg(atan(rw[1] / rw[2])),
                           CircStats::deg(atan(rw[1] / rw[2]))))
    return(angle)
  }
  return(apply(d, 1, angline))
}

# spatGrad 
spatGrad <- function(r, th = -Inf, projected = FALSE) {
  if (raster::nlayers(r) > 1) { r <- raster::calc(r, mean, na.rm = TRUE) }
  re <- raster::res(r)
  y  <- data.table(raster::adjacent(r, 1:ncell(r), directions = 8, pairs = TRUE))
  y  <- na.omit(y[, climFocal := getValues(r)[from]][order(from, to)])
  y[, clim := getValues(r)[to]]
  y[, sy   := rowFromCell(r, from) - rowFromCell(r, to)]
  y[, sx   := colFromCell(r, to)   - colFromCell(r, from)]
  y[sx > 1,  sx := -1]
  y[sx < -1, sx :=  1]
  y[, code := paste0(sx, sy)]
  y[.(code = c("10", "-10", "-11", "-1-1", "11", "1-1", "01", "0-1"),
      to   = c("climE", "climW", "climNW", "climSW", "climNE", "climSE", "climN", "climS")),
    on = "code", code := i.to]
  y  <- dcast(y[, c("from", "code", "clim")], from ~ code, value.var = "clim")
  y[, climFocal := getValues(r)[from]]
  
  # Set spatial distance based on projection style (Uniform distance scaling for rain)
  ifelse(projected == TRUE, d <- 1, d <- 111.325)
  
  # CRITICAL UPDATE FOR PRECIPITATION: Removed the latitudinal cosine adjustment 
  # which skews spatial calculations for non-temperature variables.
  y[, gradWE1 := (climN  - climNW)  / (d * re[1])]
  y[, gradWE2 := (climFocal - climW) / (d * re[1])]
  y[, gradWE3 := (climS  - climSW)  / (d * re[1])]
  y[, gradWE4 := (climNE - climN)   / (d * re[1])]
  y[, gradWE5 := (climE  - climFocal) / (d * re[1])]
  y[, gradWE6 := (climSE - climS)   / (d * re[1])]
  y[, gradNS1 := (climNW - climW)   / (d * re[2])]
  y[, gradNS2 := (climN  - climFocal)  / (d * re[2])]
  y[, gradNS3 := (climNE - climE)   / (d * re[2])]
  y[, gradNS4 := (climW  - climSW)  / (d * re[2])]
  y[, gradNS5 := (climFocal - climS)   / (d * re[2])]
  y[, gradNS6 := (climE  - climSE)  / (d * re[2])]
  
  y[, WEgrad := apply(.SD, 1, function(x) stats::weighted.mean(x, c(1,2,1,1,2,1), na.rm = TRUE)), .SDcols = 11:16]
  y[, NSgrad := apply(.SD, 1, function(x) stats::weighted.mean(x, c(1,2,1,1,2,1), na.rm = TRUE)), .SDcols = 17:22]
  y[is.na(WEgrad) & !is.na(NSgrad), WEgrad := 0L]
  y[!is.na(WEgrad) & is.na(NSgrad), NSgrad := 0L]
  y[, angle := angulo(.SD$WEgrad, .SD$NSgrad), .SDcols = c("WEgrad", "NSgrad")]
  y[, Grad  := sqrt(apply(cbind((y$WEgrad^2), (y$NSgrad^2)), 1, sum, na.rm = TRUE))]
  
  from <- data.table(1:ncell(r))
  y    <- y[from]
  rAng  <- rGrad <- raster::raster(r)
  rAng[y$from]  <- y$angle
  rGrad[y$from] <- y$Grad
  rGrad[rGrad[] < th] <- th
  output <- raster::stack(rGrad, rAng)
  names(output) <- c("Grad", "Ang")
  return(output)
}

# -- gVoCC --
gVoCC <- function(tempTrend, spatGrad) {
  VoCC    <- tempTrend[[1]] / spatGrad[[1]]
  ind     <- which(getValues(VoCC) > 0)
  VoCCang <- spatGrad[[2]]
  VoCCang[ind] <- spatGrad[[2]][ind] + 180
  VoCCang[]    <- ifelse(VoCCang[] >= 360, VoCCang[] - 360, VoCCang[])
  output  <- stack(VoCC, VoCCang)
  names(output) <- c("voccMag", "voccAng")
  return(output)
}
# 8. Temporal trend
message("Calculating temporal precipitation trends ...")
tr <- tempTrend(yrClim, th = trend_threshold)
writeRaster(tr, filename = file.path(out_dir, "precip_temporal_trend.tif"), format = "GTiff", overwrite = TRUE)

# 9. Spatial trend
message("Calculating spatial precipitation gradient ...")
sg <- spatGrad(yrClim, th = grad_threshold, projected = is_projected)
writeRaster(sg, filename = file.path(out_dir, "precip_spatial_gradient.tif"), format = "GTiff", overwrite = TRUE)

# 10. Gradient-Based Climate Velocity
message("Calculating precipitation gVoCC ...")
v   <- gVoCC(tr, sg)
vel <- v[[1]]   # velocity magnitude (km/year)
ang <- v[[2]]   # velocity direction (degrees)

writeRaster(v, filename = file.path(out_dir, "precip_gVoCC.tif"), format = "GTiff", overwrite = TRUE)
message(sprintf("  Velocity magnitude range: %.4f to %.4f km/yr", cellStats(vel, min), cellStats(vel, max)))

# 11. Plots and png files
